<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<ScrollPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.ViewProductFormController"
            fitToWidth="true"
            style="-fx-background-color: transparent;"
            prefWidth="450" prefHeight="650">
    <content>
        <VBox spacing="15" style="-fx-background-color: #FAF7F4; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 20;">
            
            <!-- Titre -->
            <Label text="Détails du Produit" style="-fx-font-weight: bold; -fx-text-fill: #6B4423;">
                <font>
                    <Font size="18"/>
                </font>
            </Label>
            
            <Separator style="-fx-background-color: #D4B896; -fx-pref-height: 2;" />
            
            <!-- Image du produit -->
            <VBox spacing="10" alignment="CENTER" style="-fx-background-color: white; -fx-border-color: #D4C5B9; -fx-border-radius: 10; -fx-border-width: 2; -fx-padding: 15;">
                <ImageView fx:id="imgView" fitWidth="120" fitHeight="120" preserveRatio="true"
                           style="-fx-background-radius: 10; -fx-border-radius: 10;" />
            </VBox>
            
            <!-- Infos produit -->
            <VBox spacing="10">
                <!-- Chaque label stylé comme dans AddProductForm -->
                <Label fx:id="lblName" style="-fx-text-fill: #6B4423; -fx-font-weight: bold; -fx-font-size: 14;" wrapText="true"/>
                <Label fx:id="lblCategory" style="-fx-text-fill: #6B4423; -fx-font-weight: bold; -fx-font-size: 14;" wrapText="true"/>
                <Label fx:id="lblPrice" style="-fx-text-fill: #6B4423; -fx-font-weight: bold; -fx-font-size: 14;" wrapText="true"/>
                <Label fx:id="lblStock" style="-fx-text-fill: #6B4423; -fx-font-weight: bold; -fx-font-size: 14;" wrapText="true"/>
                <Label fx:id="lblSize" style="-fx-text-fill: #6B4423; -fx-font-weight: bold; -fx-font-size: 14;" wrapText="true"/>
                <Label fx:id="lblColor" style="-fx-text-fill: #6B4423; -fx-font-weight: bold; -fx-font-size: 14;" wrapText="true"/>
                
                <Label text="Description:" style="-fx-text-fill: #6B4423; -fx-font-weight: bold; -fx-font-size: 14;"/>
                <TextArea fx:id="txtDescription" editable="false" wrapText="true" prefRowCount="4"
                          style="-fx-background-color: white; -fx-border-color: #D4C5B9; -fx-border-radius: 8; -fx-padding: 10;"/>
            </VBox>
            
            <!-- Bouton Fermer -->
            <Button fx:id="btnClose" text="❌ Fermer" onAction="#handleClose" maxWidth="Infinity"
                    style="-fx-background-color: #9C7A5C; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold; -fx-cursor: hand;">
                <padding>
                    <Insets top="12" bottom="12" left="20" right="20"/>
                </padding>
            </Button>
        </VBox>
    </content>
</ScrollPane>
