<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane minHeight="-Infinity" minWidth="-Infinity" prefHeight="601.0" prefWidth="777.0" style="-fx-background-color: #f5f0eb;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.UsersController">
    
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>
   <center>
      <VBox minHeight="-Infinity" minWidth="-Infinity" prefHeight="200.0" prefWidth="100.0" spacing="10.0" BorderPane.alignment="CENTER">
         <children>
                
                <HBox spacing="15.0">
               <children>
                  <Region prefHeight="47.0" prefWidth="286.0" HBox.hgrow="ALWAYS" />
         
                     <!-- Barre de recherche -->
                     <TextField fx:id="txtSearch" maxWidth="Infinity" prefHeight="47.0" prefWidth="215.0" promptText="🔍 Rechercher un utilisateur (nom, email, rôle)..." style="-fx-background-color: #FAF7F4; -fx-border-color: #C9A88A; -fx-border-radius: 10; -fx-border-width: 1.5; -fx-font-size: 14;" HBox.hgrow="ALWAYS">
                         <padding>
                             <Insets bottom="12" left="20" right="20" top="12" />
                         </padding>
                     </TextField>
                      
                     <Button fx:id="btnAddNewUser" minHeight="-Infinity" onAction="#handleAdd" prefHeight="44.0" prefWidth="203.0" style="-fx-background-color: #9C7A5C; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 14;" text="➕ Ajouter un Utilisateur" HBox.hgrow="ALWAYS">
                          <padding>
                              <Insets bottom="12" left="20" right="20" top="12" />
                          </padding>
                      </Button>
               </children></HBox>
              <VBox minHeight="-Infinity" prefHeight="529.0" prefWidth="788.0" spacing="20" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(156,106,74,0.2), 15,0,0,3);" VBox.vgrow="ALWAYS">
                  <padding>
                      <Insets bottom="25" left="25" right="25" top="25" />
                  </padding>
                  
                  <!-- En-tête avec titre -->
                  <HBox alignment="CENTER_LEFT" spacing="15">
                      <Label style="-fx-font-weight: bold;" text="Liste des Utilisateurs" textFill="#6B4423">
                          <font>
                              <Font size="24" />
                          </font>
                      </Label>
                  </HBox>
                  
                  <Separator style="-fx-background-color: #D4B896;" />
      
                  <!-- TableView -->
                  <TableView fx:id="userTable" prefHeight="400.0" prefWidth="758.0" stylesheets="@../application/styles/application.css" VBox.vgrow="ALWAYS">
                      <columns>
                          <TableColumn fx:id="colUsername" minWidth="150" prefWidth="200" text="Nom d'utilisateur" />
                          <TableColumn fx:id="colEmail" minWidth="180" prefWidth="220" text="Email" />
                          <TableColumn fx:id="colRole" minWidth="100" prefWidth="157.3333740234375" text="Rôle" />
                          <TableColumn fx:id="colActions" minWidth="120" prefWidth="122.66668701171875" text="Actions" />
                      </columns>
                      <columnResizePolicy>
                          <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                      </columnResizePolicy>
                  </TableView>
              </VBox>
         </children>
      </VBox>
   </center>
</BorderPane>
