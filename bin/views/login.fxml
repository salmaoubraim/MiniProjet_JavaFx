<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="600" prefWidth="900" style="-fx-background-color: linear-gradient(to bottom right, #f5f7fa, #e8eef5);" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.LoginController">
   
      <!-- Container principal avec effet carte -->
   <HBox alignment="CENTER" maxHeight="500.0" maxWidth="800.0" prefWidth="899.0" spacing="0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 25, 0, 0, 5);">
      
            <!-- Panneau gauche - Image et branding -->
      <VBox alignment="CENTER" prefWidth="350.0" style="-fx-background-color: linear-gradient(to bottom, #9C6A4A, #7d5439); -fx-background-radius: 20 0 0 20;">
         <padding>
            <Insets bottom="40" left="30" right="30" top="40" />
         </padding>
         
               <!-- Logo et nom -->
         <HBox alignment="CENTER" spacing="12">
            <ImageView fitHeight="50" fitWidth="50" preserveRatio="true">
               <image>
                  <Image url="@../images/robe%20(1).png" />
               </image>
            </ImageView>
            <Label text="Boutique Chic" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="28" />
               </font>
            </Label>
         </HBox>
         
               <Region minHeight="30" VBox.vgrow="ALWAYS" />
         <ImageView fitHeight="200.0" fitWidth="197.0">
            <image>
               <Image url="@../images/img4.png" />
            </image>
         </ImageView>
         
               <Region minHeight="20" VBox.vgrow="ALWAYS" />
         
               <!-- Texte de bienvenue -->
         <Label text="Gérez votre boutique" textAlignment="CENTER" textFill="WHITE" wrapText="true">
            <font>
               <Font name="System" size="18" />
            </font>
         </Label>
         <Label text="avec élégance et simplicité" textAlignment="CENTER" textFill="#E8D5CA" wrapText="true">
            <font>
               <Font name="System" size="14" />
            </font>
            <VBox.margin>
               <Insets top="5" />
            </VBox.margin>
         </Label>
      </VBox>
      
            <!-- Panneau droit - Formulaire de connexion -->
      <VBox alignment="CENTER" prefWidth="450" spacing="25">
         <padding>
            <Insets bottom="50" left="50" right="50" top="50" />
         </padding>
         
               <!-- Titre -->
         <VBox alignment="CENTER" spacing="8">
            <Label style="-fx-text-fill: #2c3e50;" text="Connexion">
               <font>
                  <Font name="System Bold" size="32" />
               </font>
            </Label>
            <Label style="-fx-text-fill: #7f8c8d;" text="Accédez à votre espace de gestion">
               <font>
                  <Font name="System" size="13" />
               </font>
            </Label>
         </VBox>
         
               <Region minHeight="10" />
         
               <!-- Champ Username -->
         <VBox spacing="8">
            <Label style="-fx-text-fill: #34495e; -fx-font-weight: 600;" text="Nom d'utilisateur">
               <font>
                  <Font size="13" />
               </font>
            </Label>
            <TextField fx:id="txtUsername" onMouseEntered="#onFieldHover" onMouseExited="#onFieldExit" promptText="Entrez votre nom d'utilisateur" style="-fx-background-color: #f8f9fa; -fx-background-radius: 10; -fx-border-color: #e0e0e0; -fx-border-radius: 10; -fx-border-width: 1.5; -fx-padding: 12 15; -fx-font-size: 14;">
            </TextField>
         </VBox>
         
               <!-- Champ Password -->
         <VBox spacing="8">
            <HBox alignment="CENTER_LEFT">
               <Label style="-fx-text-fill: #34495e; -fx-font-weight: 600;" text="Mot de passe">
                  <font>
                     <Font size="13" />
                  </font>
               </Label>
               <Region HBox.hgrow="ALWAYS" />
            </HBox>
            <PasswordField fx:id="txtPassword" onMouseEntered="#onFieldHover" onMouseExited="#onFieldExit" promptText="Entrez votre mot de passe" style="-fx-background-color: #f8f9fa; -fx-background-radius: 10; -fx-border-color: #e0e0e0; -fx-border-radius: 10; -fx-border-width: 1.5; -fx-padding: 12 15; -fx-font-size: 14;">
            </PasswordField>
         </VBox>
         
               <!-- Bouton de connexion -->
         <Button fx:id="btnLogin" maxWidth="Infinity" onAction="#handleLogin" onMouseEntered="#onButtonHover" onMouseExited="#onButtonExit" prefWidth="350.0" style="-fx-background-color: #9C6A4A; -fx-text-fill: white; -fx-background-radius: 10; -fx-font-weight: bold; -fx-font-size: 14; -fx-padding: 14; -fx-cursor: hand;" text="SE CONNECTER">
         </Button>
         
               <!-- ★ NOUVEAU: Lien d'inscription -->
         <HBox alignment="CENTER" spacing="5">
            <Label style="-fx-text-fill: #7f8c8d;" text="Vous n'avez pas de compte ?">
               <font>
                  <Font size="13" />
               </font>
            </Label>
            <Hyperlink fx:id="linkRegister" onAction="#handleRegister" style="-fx-text-fill: #9C6A4A; -fx-font-weight: bold; -fx-border-color: transparent; -fx-cursor: hand;" text="S'inscrire">
               <font>
                  <Font size="13" />
               </font>
            </Hyperlink>
         </HBox>
         
               <Region minHeight="5" />
      </VBox>
   </HBox>
</StackPane>
