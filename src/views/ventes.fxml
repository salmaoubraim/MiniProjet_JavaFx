<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane style="-fx-background-color: #F5F0E8;" stylesheets="@../application/styles/application.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.VentesController">
    
    <!-- Contenu principal -->
    <center>
        <HBox prefHeight="567.0" prefWidth="1341.0" spacing="25" style="-fx-padding: 30;">
            
            <!-- Partie gauche - Formulaire et articles -->
            <VBox prefHeight="834.0" prefWidth="486.0" spacing="20" HBox.hgrow="ALWAYS">
                
                <!-- Section ajout d'article -->
                <VBox spacing="20" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(107, 68, 35, 0.2), 15, 0, 0, 3);">
                    
                    <Label text="Ajouter un Article" textFill="#6B4423">
                        <font>
                            <Font name="Arial Bold" size="18" />
                        </font>
                    </Label>
                    
                    <Separator style="-fx-background-color: #D4B896;" />
                    
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Produit" textFill="#6B4423">
                                <font><Font name="Arial" size="13" /></font>
                            </Label>
                            <ComboBox fx:id="produitComboBox" prefWidth="250" promptText="Sélectionner..." style="-fx-background-color: white; -fx-border-color: #C5A572; -fx-border-radius: 6; -fx-background-radius: 6;" />
                        </VBox>
                        
                        <VBox spacing="5">
                            <Label text="Quantité" textFill="#6B4423">
                                <font><Font name="Arial" size="13" /></font>
                            </Label>
                            <Spinner fx:id="quantiteSpinner" editable="true" prefWidth="100" style="-fx-border-color: #C5A572; -fx-border-radius: 6;" />
                        </VBox>
                        
                        <VBox alignment="BOTTOM_LEFT" spacing="5">
                            <Label text=" " />
                            <Button onAction="#ajouterArticle" prefHeight="35" prefWidth="120" style="-fx-background-color: #8B6F47; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-size: 13; -fx-font-weight: bold; -fx-cursor: hand;" text="+ Ajouter" />
                        </VBox>
                    </HBox>
                </VBox>
                
                <!-- Tableau des articles de la vente en cours -->
                <VBox prefHeight="346.0" prefWidth="678.0" spacing="15" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(107, 68, 35, 0.2), 15, 0, 0, 3);" VBox.vgrow="ALWAYS">
                    
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Articles de la Facture" textFill="#6B4423">
                            <font>
                                <Font name="Arial Bold" size="18" />
                            </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#retirerArticle" style="-fx-background-color: #9B6B4A; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 6 15; -fx-font-weight: bold; -fx-cursor: hand;" text="🗑 Retirer" />
                    </HBox>
                    
                    <Separator style="-fx-background-color: #D4B896;" />
                    
                    <TableView fx:id="articlesTableView" prefHeight="190.0" prefWidth="627.0" style="-fx-background-color: transparent; -fx-border-color: #C5A572; -fx-border-radius: 6;" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="articleProduitColumn" prefWidth="200" text="Produit" />
                            <TableColumn fx:id="articlePrixColumn" prefWidth="100" style="-fx-alignment: CENTER;" text="Prix Unit." />
                            <TableColumn fx:id="articleQuantiteColumn" prefWidth="80" style="-fx-alignment: CENTER;" text="Qté" />
                            <TableColumn fx:id="articleTotalColumn" prefWidth="120" style="-fx-alignment: CENTER;" text="Total" />
                        </columns>
                  <columnResizePolicy>
                     <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                  </columnResizePolicy>
                    </TableView>
                    
                    <!-- Total de la facture -->
                    <HBox alignment="CENTER_RIGHT" prefHeight="0.0" prefWidth="627.0" spacing="20" style="-fx-padding: 15 0 0 0;">
                        <Label text="Total de la Facture :" textFill="#6B4423">
                            <font><Font name="Arial Bold" size="16" /></font>
                        </Label>
                        <Label fx:id="totalFactureLabel" text="0.00 DH" textFill="#8B6F47">
                            <font><Font name="Arial Bold" size="22" /></font>
                        </Label>
                    </HBox>
                    
                    <HBox alignment="CENTER" prefHeight="14.0" prefWidth="627.0" spacing="15" style="-fx-padding: 10 0 0 0;">
                        <Button onAction="#validerVente" prefHeight="45" prefWidth="180" style="-fx-background-color: #8B6F47; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 15; -fx-font-weight: bold; -fx-cursor: hand;" text="✓ Valider la Vente" />
                        <Button onAction="#annulerVente" prefHeight="45" prefWidth="150" style="-fx-background-color: #C5A572; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 15; -fx-font-weight: bold; -fx-cursor: hand;" text="✕ Annuler" />
                    </HBox>
                </VBox>
            </VBox>
             
                   <!-- Historique -->
             <VBox prefHeight="507.0" prefWidth="516.0" spacing="15" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(107, 68, 35, 0.2), 15, 0, 0, 3);">
                 
                          <HBox alignment="CENTER_LEFT" spacing="10">
                     <Label text="Historique des Ventes" textFill="#6B4423">
                         <font>
                             <Font name="Arial Bold" size="16" />
                         </font>
                     </Label>
                     <Region HBox.hgrow="ALWAYS" />
                     <Button onAction="#actualiserVentes" style="-fx-background-color: #A68B5B; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 5 12; -fx-font-size: 14; -fx-cursor: hand;" text="↻" />
                 </HBox>
                 
                          <Separator style="-fx-background-color: #D4B896;" />
                 
                                         <TableView fx:id="ventesTableView" prefHeight="216.0" prefWidth="538.0" style="-fx-background-color: transparent; -fx-border-color: #C5A572; -fx-border-radius: 6;" VBox.vgrow="ALWAYS">
                     <columns>
                         <TableColumn fx:id="venteIdColumn" prefWidth="50" style="-fx-alignment: CENTER;" text="N°" />
                         <TableColumn fx:id="venteDateColumn" prefWidth="120" style="-fx-alignment: CENTER;" text="Date" />
                         <TableColumn fx:id="venteTotalColumn" prefWidth="100" style="-fx-alignment: CENTER;" text="Total (DH)" />
                     </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
                 </TableView>
                 
                          <HBox alignment="CENTER" spacing="10">
                     <Button onAction="#voirDetails" prefWidth="140" style="-fx-background-color: #8B6F47; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 8 15; -fx-font-weight: bold; -fx-cursor: hand;" text="📄 Voir Détails" />
               <Button onAction="#supprimerVente" prefHeight="21.0" prefWidth="150" style="-fx-background-color: #C5A572; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 15; -fx-font-weight: bold; -fx-cursor: hand;" text="✕ Supprimer" />
                 </HBox>
             </VBox>
        </HBox>
    </center>
    
</BorderPane>
